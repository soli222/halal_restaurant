rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read — anyone can browse restaurants & reviews
    match /restaurants/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /reviews/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Analytics: anyone can write (captures anonymous page views), authenticated read only
    match /analytics/{id} {
      allow write: if true;
      allow read: if request.auth != null;
    }

    // Reports: authenticated write only, no client reads (admin reads via Admin SDK)
    match /reports/{id} {
      allow write: if request.auth != null;
      allow read: if false;
    }

    // Users: owner can read/write their own doc.
    // Role is restricted to 'customer' or 'owner' — prevents client-side self-elevation to 'admin'.
    // Admin SDK bypasses these rules and can write any role server-side.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.get('role', 'customer') in ['customer', 'owner'];
    }

    match /favourites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Subscriptions: owner can read their own; written by Stripe webhook via Admin SDK only
    match /subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Verification requests: owner can read their own submissions (by ownerId field).
    // New requests use addDoc with auto-generated IDs + ownerId field.
    // Old requests used userId as doc ID — both styles are supported via collection-group read.
    // Writes: new docs must have ownerId matching the authenticated user.
    //         updates to existing docs require the stored ownerId to match.
    match /verification_requests/{reqId} {
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        reqId == request.auth.uid
      );
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Notifications: owner can read/write their own notification items
    match /notifications/{userId}/items/{notifId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
